{%- style -%}
  .operational-ticker-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    overflow: hidden;
    position: relative;
    padding: 0.5rem 0;
    user-select: none;
  }

  .operational-ticker-track {
    display: flex;
    width: max-content;
    animation: operational-marquee {{ section.settings.speed }}s linear infinite;
  }

  .operational-ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes operational-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .operational-ticker-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .operational-ticker-item {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: {{ section.settings.text_color }};
    white-space: nowrap;
    padding: 0 1.35rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  .operational-ticker-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: {{ section.settings.accent_color }};
    margin-right: 1.35rem;
    opacity: 0.85;
  }
{%- endstyle -%}

<section class="operational-ticker-{{ section.id }}" aria-label="Operational Updates">
  <div class="operational-ticker-track">
    <!-- Set 1 -->
    <div class="operational-ticker-group">
      {%- for block in section.blocks -%}
        <span class="operational-ticker-item">
          {{ block.settings.text }}
        </span>
        <span class="operational-ticker-dot" aria-hidden="true"></span>
      {%- endfor -%}
    </div>
    <!-- Set 2 (for seamless loop) -->
    <div class="operational-ticker-group" aria-hidden="true">
      {%- for block in section.blocks -%}
        <span class="operational-ticker-item">
          {{ block.settings.text }}
        </span>
        <span class="operational-ticker-dot" aria-hidden="true"></span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Operational Ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0e1014"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#232730"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#d1d5db"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separator Color",
      "default": "#f59e0b"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Ticker Text",
          "default": "CENTRAL WAREHOUSE: HOUSTON, TX"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Operational Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "CENTRAL WAREHOUSE: HOUSTON, TX" } },
        { "type": "item", "settings": { "text": "DISPATCHED WITHIN 24 BUSINESS HOURS" } },
        { "type": "item", "settings": { "text": "100% BRAND NEW FACTORY-SEALED PRODUCTS" } },
        { "type": "item", "settings": { "text": "DIRECT WAREHOUSE WARRANTY" } },
        { "type": "item", "settings": { "text": "DIRECT DISTRIBUTOR OVERSTOCK INVENTORY" } },
        { "type": "item", "settings": { "text": "DIRECT SHIPPING ACROSS TEXAS" } }
      ]
    }
  ]
}
{% endschema %}
