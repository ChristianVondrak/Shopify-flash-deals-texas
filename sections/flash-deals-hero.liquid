{%- style -%}
  /* ================================================
     FLASH DEALS TEXAS - Hero Section
     Fuentes: Outfit + Inter (Google Fonts)
  ================================================ */

  .fdtx-hero {
    position: relative;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    min-height: calc(100vh - 205px);
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .fdtx-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 70% at 85% 40%, rgba(245, 158, 11, 0.1) 0%, transparent 65%),
      radial-gradient(ellipse 55% 60% at 15% 75%, rgba(220, 38, 38, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse 40% 50% at 50% 10%, rgba(99, 102, 241, 0.04) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .fdtx-hero-inner {
    max-width: var(--page-width, 1200px);
    width: 100%;
    margin: 0 auto;
    padding: 0 2.5rem;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .fdtx-hero-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fdtx-hero-heading {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2.8rem, 4.8vw, 4.4rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 1rem;
  }

  .fdtx-hero-heading-accent {
    background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
  }

  .fdtx-hero-subtext {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.08rem;
    line-height: 1.6;
    color: {{ section.settings.subtext_color }};
    margin: 0 0 2rem;
    max-width: 100%;
  }

  .fdtx-hero-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .fdtx-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    background: #dc2626;
    border: 2px solid #dc2626;
    padding: 0.85rem 1.8rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4);
  }

  .fdtx-cta-primary:hover {
    background: #b91c1c;
    border-color: #b91c1c;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(220, 38, 38, 0.5);
  }

  .fdtx-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    background: transparent;
    border: 2px solid rgba(148, 163, 184, 0.4);
    padding: 0.85rem 1.8rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .fdtx-cta-secondary:hover {
    border-color: #f59e0b;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    transform: translateY(-2px);
  }

  .fdtx-hero-trust {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .fdtx-trust-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: {{ section.settings.subtext_color }};
  }

  .fdtx-trust-icon {
    color: #f59e0b;
    flex-shrink: 0;
  }

  .fdtx-hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  /* ── TARJETA DEL PRODUCTO (ESTILO MOCKUP: BLANCA, CABECERA ROJA CON % Y PRECIO TACHADO) ── */
  .fdtx-hero-card {
    background: #ffffff;
    border-radius: 20px;
    box-shadow:
      0 20px 48px -6px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.15);
    overflow: hidden;
    width: 100%;
    max-width: 290px;
    text-decoration: none;
    display: block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .fdtx-hero-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow:
      0 32px 64px -10px rgba(0, 0, 0, 0.58),
      0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  /* Cabecera roja superior con % y DESCUENTO */
  .fdtx-hero-card-header {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
    color: #ffffff;
    text-align: center;
    padding: 0.85rem 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    box-shadow: inset 0 -2px 6px rgba(0, 0, 0, 0.12);
  }

  .fdtx-hero-card-discount {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .fdtx-hero-card-discount-label {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.1;
    margin-top: 2px;
  }

  /* Cuerpo blanco de la tarjeta */
  .fdtx-hero-card-body {
    background: #ffffff;
    padding: 1.35rem 1.25rem 1.45rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Envoltorio de imagen limpia */
  .fdtx-hero-card-image-wrap {
    width: 100%;
    height: 175px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    overflow: hidden;
  }

  .fdtx-hero-card-image-wrap img {
    max-height: 165px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.18));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fdtx-hero-card:hover .fdtx-hero-card-image-wrap img {
    transform: scale(1.07) translateY(-3px);
  }

  .fdtx-hero-card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .fdtx-hero-card-placeholder svg {
    width: 52px;
    height: 52px;
    color: #cbd5e1;
  }

  /* Título del producto */
  .fdtx-hero-card-title {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    max-width: 100%;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  /* Precios alineados verticalmente como en el mockup */
  .fdtx-hero-card-prices {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: 100%;
  }

  .fdtx-hero-card-compare {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: line-through;
    line-height: 1.2;
  }

  .fdtx-hero-card-price {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  @media screen and (max-width: 989px) {
    .fdtx-hero { padding: 1.5rem 0 1.25rem; }
    .fdtx-hero-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      min-height: unset;
      text-align: center;
      padding: 0 1.5rem;
    }
    .fdtx-hero-content { align-items: center; }
    .fdtx-hero-heading { font-size: clamp(2rem, 7vw, 2.8rem); }
    .fdtx-hero-heading-accent { display: inline; }
    .fdtx-hero-ctas { justify-content: center; }
    .fdtx-hero-trust { justify-content: center; }
    .fdtx-hero-visual { order: -1; }
    .fdtx-hero-card { max-width: 275px; margin: 0 auto; }
  }

  @media screen and (max-width: 600px) {
    .fdtx-hero { padding: 1.25rem 0 1rem; }
    .fdtx-hero-inner { gap: 1.25rem; }
    .fdtx-cta-primary, .fdtx-cta-secondary {
      width: 100%;
      justify-content: center;
      padding: 0.75rem 1.15rem;
    }
    .fdtx-hero-ctas { flex-direction: column; gap: 0.5rem; }
    .fdtx-hero-trust { gap: 0.65rem; }
    .fdtx-trust-item { font-size: 0.7rem; }
    .fdtx-hero-card { max-width: 250px; }
    .fdtx-hero-card-discount { font-size: 1.9rem; }
    .fdtx-hero-card-price { font-size: 1.85rem; }
  }
{%- endstyle -%}

<section class="fdtx-hero" aria-label="{{ section.settings.heading_accent }} {{ section.settings.heading_rest }}">
  <div class="fdtx-hero-inner">

    <div class="fdtx-hero-content">
      <h1 class="fdtx-hero-heading">
        {%- if section.settings.heading_accent != blank -%}
          <span class="fdtx-hero-heading-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {%- if section.settings.heading_rest != blank -%}
          {{- section.settings.heading_rest -}}
        {%- endif -%}
      </h1>

      {%- if section.settings.subtext != blank -%}
        <p class="fdtx-hero-subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="fdtx-hero-ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url | default: '#flash-deals' }}" class="fdtx-cta-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            {{ section.settings.cta_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url | default: '#alto-valor' }}" class="fdtx-cta-secondary">
            {{ section.settings.cta_secondary_label }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="fdtx-hero-trust">
        <span class="fdtx-trust-item">
          <svg class="fdtx-trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          100% Nuevo &middot; Sellado
        </span>
        <span class="fdtx-trust-item">
          <svg class="fdtx-trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          Envio en 24h desde Dallas
        </span>
        <span class="fdtx-trust-item">
          <svg class="fdtx-trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Garantia 30 dias
        </span>
      </div>
    </div>

    {%- assign feat_product = section.settings.featured_product -%}
    {%- if feat_product == blank or feat_product.title == blank -%}
      {%- for prod in collections.all.products -%}
        {%- if prod.compare_at_price > prod.price -%}
          {%- assign feat_product = prod -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if feat_product != blank and feat_product.title != blank -%}
      {%- assign hero_title = feat_product.title -%}
      {%- assign hero_url = feat_product.url -%}
      {%- assign hero_price = feat_product.price | money -%}
      {%- if feat_product.compare_at_price > feat_product.price -%}
        {%- assign hero_compare = feat_product.compare_at_price | money -%}
        {%- assign hero_discount = feat_product.compare_at_price | minus: feat_product.price | times: 100.0 | divided_by: feat_product.compare_at_price | round | prepend: '-' | append: '%' -%}
      {%- else -%}
        {%- assign hero_compare = section.settings.card_compare | default: '$299.00' -%}
        {%- assign hero_discount = section.settings.card_discount | default: '-42%' -%}
      {%- endif -%}
      {%- assign card_thumb = section.settings.custom_image | default: feat_product.featured_image -%}
    {%- else -%}
      {%- assign hero_title = '' -%}
      {%- assign hero_url = section.settings.cta_primary_url | default: '#flash-deals' -%}
      {%- assign hero_price = section.settings.card_price | default: '$134.50' -%}
      {%- assign hero_compare = section.settings.card_compare | default: '$299.00' -%}
      {%- assign hero_discount = section.settings.card_discount | default: '-42%' -%}
      {%- assign card_thumb = section.settings.custom_image -%}
    {%- endif -%}

    <div class="fdtx-hero-visual">
      <a href="{{ hero_url }}" class="fdtx-hero-card" title="{{ hero_title | default: 'Ver Oferta' | escape }}">

        <div class="fdtx-hero-card-header">
          <span class="fdtx-hero-card-discount">{{ hero_discount }}</span>
          <span class="fdtx-hero-card-discount-label">DESCUENTO</span>
        </div>

        <div class="fdtx-hero-card-body">
          <div class="fdtx-hero-card-image-wrap">
            {%- if card_thumb != blank -%}
              <img
                src="{{ card_thumb | image_url: width: 600 }}"
                srcset="{{ card_thumb | image_url: width: 300 }} 300w, {{ card_thumb | image_url: width: 600 }} 600w"
                sizes="290px"
                alt="{{ hero_title | escape }}"
                width="600"
                height="450"
                loading="eager"
                fetchpriority="high"
              >
            {%- else -%}
              <div class="fdtx-hero-card-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}
          </div>

          {%- if hero_title != blank -%}
            <p class="fdtx-hero-card-title">{{ hero_title }}</p>
          {%- endif -%}

          <div class="fdtx-hero-card-prices">
            <span class="fdtx-hero-card-compare">{{ hero_compare }}</span>
            <span class="fdtx-hero-card-price">{{ hero_price }}</span>
          </div>
        </div>

      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Flash Deals",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Contenido Principal" },
    { "type": "text", "id": "heading_accent", "label": "Titulo acento (ambar-rojo)", "default": "Flash Deals" },
    { "type": "text", "id": "heading_rest", "label": "Resto del titulo", "default": "Texas" },
    { "type": "textarea", "id": "subtext", "label": "Subtexto", "default": "Precios de liquidacion mayorista en herramientas, iluminacion y electricidad. Inventario directo desde Dallas, TX." },
    { "type": "header", "content": "Botones CTA" },
    { "type": "text", "id": "cta_primary_label", "label": "CTA Primario (texto)", "default": "Ver Ofertas Flash" },
    { "type": "url", "id": "cta_primary_url", "label": "CTA Primario (enlace)" },
    { "type": "text", "id": "cta_secondary_label", "label": "CTA Secundario (texto)", "default": "Alto Valor +$60" },
    { "type": "url", "id": "cta_secondary_url", "label": "CTA Secundario (enlace)" },
    { "type": "header", "content": "Producto Destacado del Hero" },
    { "type": "product", "id": "featured_product", "label": "Seleccionar Producto", "info": "La foto, precios, descuento y enlace se conectan automaticamente." },
    { "type": "image_picker", "id": "custom_image", "label": "Imagen personalizada del Hero", "info": "Opcional: Sube una foto para reemplazar la imagen del producto en el hero." },
    { "type": "header", "content": "Tarjeta de Oferta" },
    { "type": "text", "id": "card_label", "label": "Etiqueta superior", "default": "Oferta del Dia" },
    { "type": "paragraph", "content": "Campos de respaldo si no hay producto seleccionado:" },
    { "type": "text", "id": "card_discount", "label": "Descuento manual", "default": "-42%" },
    { "type": "text", "id": "card_price", "label": "Precio oferta manual", "default": "$134.50" },
    { "type": "text", "id": "card_compare", "label": "Precio tachado manual", "default": "$299.00" },
    { "type": "header", "content": "Colores y Espaciado" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#0f172a" },
    { "type": "color", "id": "heading_color", "label": "Color del titulo", "default": "#f1f5f9" },
    { "type": "color", "id": "subtext_color", "label": "Color del subtexto", "default": "#94a3b8" },
    { "type": "range", "id": "padding_top", "min": 10, "max": 100, "step": 2, "unit": "px", "label": "Espaciado superior", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 10, "max": 100, "step": 2, "unit": "px", "label": "Espaciado inferior", "default": 28 }
  ],
  "presets": [{ "name": "Hero Flash Deals Texas" }]
}
{% endschema %}
