{%- style -%}
  .category-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .category-grid-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .category-grid-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  .category-grid-heading {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.35rem;
    color: {{ section.settings.heading_color }};
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .category-grid-subheading {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.45;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  /* ── SLIM HORIZONTAL GRID (4 COLUMNAS) ── */
  .category-cards-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  @media screen and (max-width: 989px) {
    .category-cards-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }

  @media screen and (max-width: 500px) {
    .category-cards-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.55rem;
    }
  }

  /* ── TARJETA SLIM / HORIZONTAL ── */
  .category-slim-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    padding: 0.65rem 0.95rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 58px;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }

  @media screen and (max-width: 500px) {
    .category-slim-card {
      padding: 0.55rem 0.7rem;
      gap: 0.55rem;
      min-height: 52px;
      border-radius: 12px;
    }
  }

  .category-slim-card:hover {
    transform: translateY(-2px);
    border-color: #d97706;
    box-shadow: 0 8px 18px -2px rgba(15, 23, 42, 0.08);
  }

  /* ── ICONO COMPACTO ── */
  .category-slim-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fef3c7;
    color: #d97706;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .category-slim-card:hover .category-slim-icon {
    transform: scale(1.06);
    background: #d97706;
    color: #ffffff;
  }

  .category-slim-icon svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 500px) {
    .category-slim-icon {
      width: 30px;
      height: 30px;
      border-radius: 8px;
    }
    .category-slim-icon svg {
      width: 15px;
      height: 15px;
    }
  }

  /* ── INFORMACIÓN DE CATEGORÍA ── */
  .category-slim-info {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .category-slim-title {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }

  @media screen and (max-width: 500px) {
    .category-slim-title {
      font-size: 0.8rem;
    }
  }

  .category-slim-card:hover .category-slim-title {
    color: #d97706;
  }

  .category-slim-meta {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media screen and (max-width: 500px) {
    .category-slim-meta {
      font-size: 0.67rem;
    }
  }

  /* ── FLECHA COMPACTA ── */
  .category-slim-arrow {
    flex-shrink: 0;
    color: #94a3b8;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .category-slim-arrow svg {
    width: 14px;
    height: 14px;
    stroke-width: 2.5;
  }

  .category-slim-card:hover .category-slim-arrow {
    color: #d97706;
    transform: translateX(2px);
  }
{%- endstyle -%}

<section class="category-grid-{{ section.id }}">
  <div class="category-grid-container">
    <div class="category-grid-header">
      <h2 class="category-grid-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="category-grid-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="category-cards-wrapper">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- assign card_url = block.settings.custom_url | default: collection.url | default: '/collections/all' -%}
        {%- assign card_title = block.settings.title | default: collection.title | default: 'Categoría' -%}
        {%- assign card_tag = block.settings.subtitle | default: 'Ver catálogo' -%}
        {%- assign icon_type = block.settings.icon | default: 'auto' -%}

        <a href="{{ card_url }}" class="category-slim-card" {{ block.shopify_attributes }}>
          <div class="category-slim-icon">
            {%- if icon_type == 'lighting' or forloop.index == 1 and icon_type == 'auto' -%}
              <!-- Foco / Iluminación -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18h6"></path>
                <path d="M10 22h4"></path>
                <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
              </svg>
            {%- elsif icon_type == 'electrical' or forloop.index == 2 and icon_type == 'auto' -%}
              <!-- Material Eléctrico / Rayo -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            {%- elsif icon_type == 'tools' or forloop.index == 3 and icon_type == 'auto' -%}
              <!-- Herramientas / Llave -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            {%- elsif icon_type == 'smart_home' or forloop.index == 4 and icon_type == 'auto' -%}
              <!-- Hogar Inteligente -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            {%- else -%}
              <!-- Caja / Lote -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            {%- endif -%}
          </div>

          <div class="category-slim-info">
            <h3 class="category-slim-title">{{ card_title }}</h3>
            <span class="category-slim-meta">{{ card_tag }}</span>
          </div>

          <div class="category-slim-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comprar por Categoría",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Explora por Especialidad"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Suministros y componentes seleccionados para tu hogar o taller"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del Título",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del Subtítulo",
      "default": "#475569"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Superior",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Inferior",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de Shopify"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono Minimalista",
          "options": [
            { "value": "auto", "label": "Automático según orden" },
            { "value": "lighting", "label": "Iluminación / Foco" },
            { "value": "electrical", "label": "Material Eléctrico / Rayo" },
            { "value": "tools", "label": "Herramientas Pro / Llave" },
            { "value": "smart_home", "label": "Hogar Inteligente / Casa" },
            { "value": "box", "label": "Lote / Caja" }
          ],
          "default": "auto"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título de la Categoría",
          "default": "Iluminación LED"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo o Etiqueta",
          "default": "+45 Productos"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Enlace Personalizado (Opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar por Categoría",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Iluminación & Lámparas",
            "subtitle": "+45 Productos",
            "icon": "lighting"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Material Eléctrico",
            "subtitle": "Cables & Conectores",
            "icon": "electrical"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Herramientas Pro",
            "subtitle": "Inalámbricas & Manuales",
            "icon": "tools"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hogar Inteligente",
            "subtitle": "Automatización & Confort",
            "icon": "smart_home"
          }
        }
      ]
    }
  ]
}
{% endschema %}
