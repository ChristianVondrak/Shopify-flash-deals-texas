{%- style -%}
  .category-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .category-grid-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .category-grid-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .category-grid-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: {{ section.settings.heading_color }};
  }

  .category-grid-subheading {
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .category-cards-wrapper {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }

  .category-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #14171c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem 1.5rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  /* Asymmetric Bento Span */
  .category-card:nth-child(1) {
    grid-column: span 7;
    height: 320px;
  }

  .category-card:nth-child(2) {
    grid-column: span 5;
    height: 320px;
  }

  .category-card:nth-child(3) {
    grid-column: span 5;
    height: 290px;
  }

  .category-card:nth-child(4) {
    grid-column: span 7;
    height: 290px;
  }

  @media screen and (max-width: 900px) {
    .category-cards-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .category-card:nth-child(n) {
      grid-column: auto;
      height: 240px;
    }
  }

  @media screen and (max-width: 550px) {
    .category-cards-wrapper {
      grid-template-columns: 1fr;
    }
    .category-card:nth-child(n) {
      height: 200px;
      padding: 1.25rem 1rem;
    }
  }

  .category-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }

  .category-card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.65;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .category-card:hover .category-card-bg {
    transform: scale(1.06);
    opacity: 0.85;
  }

  .category-card-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(14, 16, 20, 0.15) 0%, rgba(14, 16, 20, 0.75) 60%, rgba(14, 16, 20, 0.98) 100%);
    z-index: 1;
  }

  .category-card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #f59e0b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  .category-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 550px) {
    .category-title {
      font-size: 1.05rem;
    }
  }

  .category-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    opacity: 0.9;
    margin-top: 0.4rem;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }

  .category-card:hover .category-cta-link {
    gap: 0.6rem;
    opacity: 1;
    color: #fbbf24;
  }
{%- endstyle -%}

<section class="category-grid-{{ section.id }}">
  <div class="category-grid-container">
    <div class="category-grid-header">
      <h2 class="category-grid-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="category-grid-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="category-cards-wrapper">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- assign card_url = block.settings.custom_url | default: collection.url | default: '/collections/all' -%}
        {%- assign card_title = block.settings.title | default: collection.title | default: 'Categoría' -%}
        {%- assign card_tag = block.settings.subtitle | default: 'Ver colección' -%}

        <a href="{{ card_url }}" class="category-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="category-card-bg" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ card_title | escape }}" loading="lazy" width="900" height="600">
          {%- elsif collection.image != blank -%}
            <img class="category-card-bg" src="{{ collection.image | image_url: width: 900 }}" alt="{{ card_title | escape }}" loading="lazy" width="900" height="600">
          {%- else -%}
            {%- capture default_asset -%}
              {%- cycle 'bento-lighting.jpg', 'bento-electrical.jpg', 'bento-tools.jpg', 'bento-smarthome.jpg' -%}
            {%- endcapture -%}
            <img class="category-card-bg" src="{{ default_asset | asset_url }}" alt="{{ card_title | escape }}" loading="lazy" width="900" height="600">
          {%- endif -%}

          <div class="category-card-gradient"></div>

          <div class="category-card-content">
            <span class="category-tag">0{{ forloop.index }} / {{ card_tag }}</span>
            <h3 class="category-title">{{ card_title }}</h3>
            <span class="category-cta-link">
              Explorar Catálogo
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comprar por Categoría",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Comprar por Especialidad"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Encuentra componentes y suministros específicos para tu hogar o proyecto"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del Título",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del Subtítulo",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Inferior",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de Shopify"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen Personalizada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título de la Categoría",
          "default": "Iluminación LED"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo o Etiqueta",
          "default": "+45 Productos"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Enlace Personalizado (Opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar por Categoría",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Iluminación & Lámparas",
            "subtitle": "Focos, reflectores y tiras LED"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Material Eléctrico",
            "subtitle": "Cables, interruptores y tomas"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Herramientas & Fijaciones",
            "subtitle": "Taladros, sets y accesorios"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hogar & Smart Home",
            "subtitle": "Dispositivos inteligentes y confort"
          }
        }
      ]
    }
  ]
}
{% endschema %}
