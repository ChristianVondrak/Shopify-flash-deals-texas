{%- style -%}
  .liquidation-faq-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .liquidation-faq-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .liquidation-faq-header {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .liquidation-faq-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.65rem;
    color: {{ section.settings.heading_color }};
    letter-spacing: -0.02em;
  }

  .liquidation-faq-subheading {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .liquidation-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .liquidation-faq-item {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .liquidation-faq-item[open] {
    border-color: #dc2626;
    background-color: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  .liquidation-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    user-select: none;
    list-style: none;
  }

  .liquidation-faq-summary:hover {
    color: #dc2626;
  }

  .liquidation-faq-summary::-webkit-details-marker {
    display: none;
  }

  .liquidation-faq-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: #dc2626;
    transition: transform 0.25s ease;
    margin-left: 1rem;
  }

  .liquidation-faq-item[open] .liquidation-faq-icon {
    transform: rotate(180deg);
  }

  .liquidation-faq-answer {
    padding: 0 1.5rem 1.35rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
  }

  .liquidation-faq-answer p {
    margin: 0;
  }
{%- endstyle -%}

<section class="liquidation-faq-{{ section.id }}" aria-label="Frequently Asked Questions">
  <div class="liquidation-faq-container">
    <div class="liquidation-faq-header">
      <h2 class="liquidation-faq-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="liquidation-faq-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="liquidation-faq-list">
      {%- for block in section.blocks -%}
        <details class="liquidation-faq-item" {{ block.shopify_attributes }}>
          <summary class="liquidation-faq-summary">
            <span>{{ block.settings.question }}</span>
            <svg class="liquidation-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="liquidation-faq-answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liquidation FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions About Liquidations"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about provenance, Texas dispatch times, and warranties."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#121418"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del Título",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del Subtítulo",
      "default": "#9ca3af"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Inferior",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question / Answer",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are items brand new or refurbished?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "All our products are 100% brand new, sealed in original factory packaging with intact seals. They come from wholesale overstock and distributor cancellations, never second-hand."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liquidation FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Are items 100% brand new or refurbished?",
            "answer": "All items are 100% brand new, sealed in original factory packaging. They come from wholesale overstock and Texas project cancellations, never from customer returns or second-hand goods."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Why are prices so low compared to traditional retail?",
            "answer": "We buy closed wholesale lots in bulk from distributors needing to quickly clear warehouse space. By selling online directly from our Houston facility without retail middleman chains, we pass the net savings directly to our customers."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take in Texas?",
            "answer": "Orders are processed and dispatched within 24 business hours from Houston, TX. Estimated delivery time is approximately 7 business days via courier."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What warranty is included with purchased products?",
            "answer": "All products include a 5-business-day warranty starting once the claim is filed and the item is returned to our Houston warehouse."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What if my product arrives damaged?",
            "answer": "If an item arrives damaged during transit, contact us immediately with photos of the product, packaging, and shipping label. We will review the case promptly and guide you through the next steps."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can products sell out quickly?",
            "answer": "Yes. Liquidation inventory is available in strictly limited quantities. Once a lot is sold out, it may not be restocked."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How can I contact Flash Deals Texas?",
            "answer": "You can reach us through any of our contact channels available on the website (phone, email, WhatsApp). We are here to help with questions regarding products, orders, and shipping."
          }
        }
      ]
    }
  ]
}
{% endschema %}
