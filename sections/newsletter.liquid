{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── FDTX BRANDED NEWSLETTER CARD ── */
  .fdtx-newsletter-wrap {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .fdtx-newsletter-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 24px;
    padding: 3rem 2rem;
    box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.06);
    text-align: center;
    position: relative;
    overflow: hidden;
    max-width: 820px;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .fdtx-newsletter-card {
      padding: 2.25rem 1.25rem;
      border-radius: 18px;
    }
  }

  .fdtx-newsletter-card h2.inline-richtext {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 auto 0.65rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    max-width: 600px;
  }

  .fdtx-newsletter-card .newsletter__subheading {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #475569;
    max-width: 600px;
    margin: 0 auto 1.75rem;
    text-align: center;
  }

  .fdtx-newsletter-card .newsletter__subheading p {
    margin: 0;
  }

  /* Form styling - Perfect Centering matching text width */
  .fdtx-newsletter-card .newsletter-form {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    max-width: 600px !important;
    margin: 0 auto !important;
  }

  .fdtx-form-inner {
    display: flex !important;
    flex-direction: row !important;
    gap: 0.75rem;
    align-items: stretch;
    width: 100% !important;
    box-sizing: border-box;
  }

  @media screen and (max-width: 550px) {
    .fdtx-form-inner {
      flex-direction: column !important;
    }
  }

  .fdtx-input-wrap {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: 100%;
  }

  .fdtx-nl-input {
    width: 100% !important;
    display: block;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 0.85rem 1.25rem;
    font-size: 0.95rem;
    color: #0f172a;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
    box-sizing: border-box;
    height: 50px;
  }

  .fdtx-nl-input:focus {
    outline: none;
    border-color: #dc2626;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
  }

  .fdtx-nl-input::placeholder {
    color: #94a3b8;
  }

  .fdtx-nl-btn {
    flex: 0 0 auto !important;
    background: #dc2626;
    color: #ffffff;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: none;
    border-radius: 12px;
    padding: 0 1.6rem;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .fdtx-nl-btn:hover {
    background: #b91c1c;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(220, 38, 38, 0.25);
  }

  .fdtx-nl-btn svg {
    width: 16px;
    height: 16px;
  }

  .fdtx-nl-trust {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748b;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .fdtx-nl-trust span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .fdtx-nl-trust svg {
    width: 13px;
    height: 13px;
    color: #059669;
  }
{%- endstyle -%}

<div class="newsletter center section-{{ section.id }}-padding">
  <div class="fdtx-newsletter-wrap">
    <div class="fdtx-newsletter-card">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'heading' -%}
            <h2 class="inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- when 'paragraph' -%}
            <div class="newsletter__subheading rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'email_form' -%}
            <div {{ block.shopify_attributes }}>
              {% form 'customer', class: 'newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="fdtx-form-inner">
                  <div class="fdtx-input-wrap">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="fdtx-nl-input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="Newsletter-error--{{ section.id }}"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="Newsletter-success--{{ section.id }}"
                      {% endif %}
                      placeholder="Ingresa tu correo para recibir alertas..."
                      required
                    >
                  </div>
                  <button
                    type="submit"
                    class="fdtx-nl-btn"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                  >
                    <span>Recibir Alertas</span>
                  </button>
                </div>

                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}" style="margin-top: 1rem; color: #dc2626; display: block;">
                    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                  </small>
                {%- endif -%}

                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="Newsletter-success--{{ section.id }}"
                    tabindex="-1"
                    autofocus
                    style="margin-top: 1rem; color: #059669; font-weight: 700;"
                  >
                    {{ 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {% endform %}

              <div class="fdtx-nl-trust">
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Avisos de lotes en tiempo real
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Inventario Dallas, TX
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Cero spam
                </span>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.newsletter.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Alertas de Liquidación & Nuevos Lotes",
          "label": "t:sections.newsletter.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Suscríbete para recibir notificaciones inmediatas de lotes de liquidación antes de que se agoten.</p>",
          "label": "t:sections.newsletter.blocks.paragraph.settings.paragraph.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
