{%- style -%}
  .liquidation-model-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .liquidation-model-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .liquidation-model-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .liquidation-model-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: {{ section.settings.heading_color }};
    letter-spacing: -0.02em;
  }

  .liquidation-model-subheading {
    font-size: 0.98rem;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .liquidation-model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media screen and (max-width: 900px) {
    .liquidation-model-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .liquidation-step-card {
    background-color: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .liquidation-step-card:hover {
    transform: translateY(-4px);
    border-color: #f59e0b;
    box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.1);
  }

  .liquidation-step-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.85rem;
    font-weight: 800;
    color: #d97706;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .liquidation-step-number::after {
    content: "";
    flex-grow: 1;
    height: 1px;
    background: #e2e8f0;
  }

  .liquidation-step-title {
    font-size: 1.18rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .liquidation-step-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }
{%- endstyle -%}

<section class="liquidation-model-{{ section.id }}" aria-label="Liquidation Model">
  <div class="liquidation-model-container">
    <div class="liquidation-model-header">
      <h2 class="liquidation-model-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="liquidation-model-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="liquidation-model-grid">
      {%- for block in section.blocks -%}
        <div class="liquidation-step-card" {{ block.shopify_attributes }}>
          <div class="liquidation-step-number">
            0{{ forloop.index }} / PHASE
          </div>
          <h3 class="liquidation-step-title">{{ block.settings.title }}</h3>
          <p class="liquidation-step-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liquidation Model",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Why are our prices true liquidation?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We acquire closed wholesale lots from contractors, distributors, and factory overstock in Texas to pass the discount directly to you."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#16181d"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#9ca3af"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Model Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Direct Surplus Lot Acquisition"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We buy directly factory overstock and job cancellations from authorized distributors in Texas."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liquidation Model",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Direct Lot Acquisition",
            "description": "We monitor and acquire closed factory overstock lots, job cancellations, and commercial surplus in Texas."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Technical Warehouse Inspection",
            "description": "Each product is received at our Houston, TX warehouse, where factory seals, original packaging, and specifications are verified before listing."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Dispatch & Delivery",
            "description": "No middlemen or traditional retail markups. We prepare and ship directly from our warehouse with estimated delivery in ~7 business days and a 5-business-day warranty upon delivery."
          }
        }
      ]
    }
  ]
}
{% endschema %}
