{%- style -%}
  .liquidation-model-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .liquidation-model-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .liquidation-model-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .liquidation-model-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #f59e0b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    margin-bottom: 0.5rem;
  }

  .liquidation-model-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: {{ section.settings.heading_color }};
    letter-spacing: -0.02em;
  }

  .liquidation-model-subheading {
    font-size: 0.98rem;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .liquidation-model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media screen and (max-width: 900px) {
    .liquidation-model-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .liquidation-step-card {
    background-color: #121418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .liquidation-step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .liquidation-step-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.85rem;
    font-weight: 800;
    color: #f59e0b;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .liquidation-step-number::after {
    content: "";
    flex-grow: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .liquidation-step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f3f4f6;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .liquidation-step-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #9ca3af;
    margin: 0;
  }
{%- endstyle -%}

<section class="liquidation-model-{{ section.id }}" aria-label="Modelo de Liquidación">
  <div class="liquidation-model-container">
    <div class="liquidation-model-header">
      <span class="liquidation-model-kicker">CADENA DE SUMINISTRO TRANSPARENTE</span>
      <h2 class="liquidation-model-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="liquidation-model-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="liquidation-model-grid">
      {%- for block in section.blocks -%}
        <div class="liquidation-step-card" {{ block.shopify_attributes }}>
          <div class="liquidation-step-number">
            0{{ forloop.index }} / FASE
          </div>
          <h3 class="liquidation-step-title">{{ block.settings.title }}</h3>
          <p class="liquidation-step-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modelo de Liquidación",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "¿Por qué nuestros precios son de liquidación real?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Adquirimos lotes cerrados de contratistas, distribuidores y sobrestock de fábrica en Texas para trasladar el descuento directamente a ti."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#16181d"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del Título",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del Subtítulo",
      "default": "#9ca3af"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Inferior",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso del Modelo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Adquisición de Lotes por Excedentes"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Compramos directamente sobrestock de fábrica y cancelaciones de obra de distribuidores autorizados en Texas a costo mayorista."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modelo de Liquidación",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Adquisición de Lotes Directos",
            "description": "Monitoreamos y compramos lotes cerrados de sobrestock de fábrica, cierres de proyectos y cancelaciones comerciales en el área de Texas."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Inspección Técnica en Bodega",
            "description": "Cada producto se recibe en nuestro almacén de Dallas, TX, donde verificamos sellos de fábrica, empaques originales y especificaciones antes de su publicación."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Despacho Directo en 24h",
            "description": "Sin intermediarios ni costos de retail tradicional. Preparamos y enviamos directo a tu domicilio o taller con garantía local de 30 días."
          }
        }
      ]
    }
  ]
}
{% endschema %}
