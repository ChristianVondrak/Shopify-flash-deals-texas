{%- style -%}
  .reviews-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .reviews-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .reviews-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .reviews-badge-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .reviews-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: {{ section.settings.heading_color }};
  }

  .reviews-subheading {
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media screen and (max-width: 989px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media screen and (max-width: 600px) {
    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .review-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.1);
    border-color: #f59e0b;
  }

  .review-stars {
    display: flex;
    gap: 0.2rem;
    color: #f59e0b;
    margin-bottom: 0.85rem;
  }

  .review-stars svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .review-text {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #334155;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .review-product-tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .review-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }

  .review-author-info {
    display: flex;
    flex-direction: column;
  }

  .review-author-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
  }

  .review-author-location {
    font-size: 0.78rem;
    color: #64748b;
  }

  .review-verified-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #059669;
    background: #ecfdf5;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
  }

  .review-verified-badge svg {
    width: 13px;
    height: 13px;
  }
{%- endstyle -%}

<section class="reviews-section-{{ section.id }}">
  <div class="reviews-container">
    <div class="reviews-header">
      <div class="reviews-badge-summary">
        <span>★ 4.9 / 5</span>
        <span>•</span>
        <span>Más de 1,400 Clientes Satisfechos</span>
      </div>
      <h2 class="reviews-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="reviews-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {%- endfor -%}
          </div>

          <p class="review-text">"{{ block.settings.text }}"</p>

          {%- if block.settings.product_tag != blank -%}
            <div>
              <span class="review-product-tag">{{ block.settings.product_tag }}</span>
            </div>
          {%- endif -%}

          <div class="review-footer">
            <div class="review-author-info">
              <span class="review-author-name">{{ block.settings.author }}</span>
              {%- if block.settings.location != blank -%}
                <span class="review-author-location">{{ block.settings.location }}</span>
              {%- endif -%}
            </div>
            <div class="review-verified-badge">
              <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Verificado
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reseñas de Clientes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Clientes que Confían en Flash Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Opiniones reales sobre calidad, rapidez de entrega y precios sin competencia"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la Sección",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del Título",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del Subtítulo",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado Inferior",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Nombre del Cliente",
          "default": "Carlos M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ubicación",
          "default": "Houston, TX"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Comentario de la Reseña",
          "default": "Excelente servicio. Pedí un set de bombillas LED y un destornillador en oferta flash; me llegó en solo 2 días a Houston y la calidad supera lo que esperaba por el precio."
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Producto Comprado (Opcional)",
          "default": "Compró: Pack Bombillas Vintage + Herramientas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reseñas de Clientes",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "David R.",
            "location": "Dallas, TX",
            "text": "Las ofertas flash son 100% reales. Compré un reflector solar LED con 40% de descuento y la potencia de iluminación es impresionante.",
            "product_tag": "Compró: Reflector Solar LED 100W"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Elena G.",
            "location": "San Antonio, TX",
            "text": "Me encantó la atención y el empaque. Productos de electricidad bien protegidos y entrega rápida. Definitivamente volveré a comprar.",
            "product_tag": "Compró: Termostato Digital + Cableado"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Martín S.",
            "location": "Austin, TX",
            "text": "Buscaba herramientas buenas para remodelar mi casa sin gastar una fortuna. Flash Deals tiene los mejores precios que he visto en Texas.",
            "product_tag": "Compró: Destornillador Pro 20V"
          }
        }
      ]
    }
  ]
}
{% endschema %}
