{%- style -%}
  .high-value-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .hvd-container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── HEADER ── */
  .hvd-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .hvd-category-tag {
    display: inline-block;
    background: #fef3c7;
    color: #b45309;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.4rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
    box-shadow: 0 2px 8px rgba(217, 119, 6, 0.15);
  }

  .hvd-heading {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 0.6rem;
    text-transform: uppercase;
  }

  .hvd-subheading {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
    color: {{ section.settings.subheading_color }};
    margin: 0 auto;
    max-width: 560px;
  }

  /* ── GRID ── */
  .hvd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.35rem;
  }

  @media screen and (max-width: 989px) {
    .hvd-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
  @media screen and (max-width: 480px) {
    .hvd-grid { grid-template-columns: repeat(2, 1fr); gap: 0.65rem; }
  }

  /* ── CARD — Estilo exacto del mockup con acolchado interior y sombras suaves ── */
  .hvd-card {
    background: #ffffff;
    border-radius: 22px;
    padding: 1.25rem;
    border: 1.5px solid #edf2f7;
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .hvd-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px -4px rgba(15, 23, 42, 0.12);
    border-color: #cbd5e1;
  }

  /* ── MEDIA WRAP — Fondo claro, bordes redondeados y producto contenido ── */
  .hvd-card-media {
    position: relative;
    width: 100%;
    padding-top: 100%;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
  }

  .hvd-card-media img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    padding: 0.65rem;
    mix-blend-mode: multiply;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hvd-card:hover .hvd-card-media img {
    transform: scale(1.06);
  }

  /* Badge descuento — forma ovalada tipo pill del mockup con tamaño grande y legible */
  .hvd-discount-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #dc2626;
    color: #ffffff;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 900;
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    z-index: 2;
    letter-spacing: -0.02em;
    box-shadow: 0 4px 15px rgba(220, 38, 38, 0.45);
    line-height: 1;
  }

  /* ── CARD BODY ── */
  .hvd-card-body {
    padding: 1.15rem 0.2rem 0.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .hvd-card-title {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
    text-decoration: none;
    text-transform: capitalize;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.25rem;
    margin-bottom: 0.75rem;
  }

  .hvd-card-title:hover { color: #d97706; }

  /* Precios en línea: compare tachado + precio venta bold */
  .hvd-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.65rem;
  }

  .hvd-compare-price {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.15rem;
    text-decoration: line-through;
    color: #94a3b8;
    font-weight: 600;
  }

  .hvd-sale-price {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Pill verde "Ahorras $X" */
  .hvd-savings-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    color: #047857;
    background: #ecfdf5;
    border: 1px solid #6ee7b7;
    padding: 0.38rem 0.95rem;
    border-radius: 9999px;
    margin-bottom: 1.15rem;
    line-height: 1;
  }

  /* Botón — Dark navy igual al mockup con buen tamaño táctil */
  .hvd-btn {
    width: 100%;
    min-height: 54px;
    padding: 0.85rem 1.25rem;
    border-radius: 14px;
    background: #0f172a;
    color: #ffffff;
    border: none;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    margin-top: auto;
  }

  .hvd-btn:hover { background: #1e293b; transform: translateY(-1px); }
  .hvd-btn:active { transform: scale(0.98); }

  @media screen and (max-width: 480px) {
    .hvd-card { padding: 0.85rem; border-radius: 16px; }
    .hvd-discount-badge { font-size: 1.05rem; padding: 0.35rem 0.75rem; top: 8px; left: 8px; }
    .hvd-card-title { font-size: 1.02rem; min-height: 2.65rem; }
    .hvd-sale-price { font-size: 1.5rem; }
    .hvd-compare-price { font-size: 0.95rem; }
    .hvd-savings-pill { font-size: 0.8rem; padding: 0.28rem 0.65rem; }
    .hvd-btn { min-height: 46px; font-size: 1rem; border-radius: 10px; }
  }

  /* Ver todo */
  .hvd-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .hvd-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
    padding: 0.65rem 1.5rem;
    border: 2px solid #0f172a;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .hvd-view-all:hover {
    background: #0f172a;
    color: #ffffff;
  }

  /* Empty state */
  .hvd-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1.5rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px dashed #cbd5e1;
    color: #64748b;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
{%- endstyle -%}

<section id="alto-valor" class="high-value-{{ section.id }}" aria-label="Lotes de Alto Valor">
  <div class="hvd-container">
    <div class="hvd-header">
      <div class="hvd-category-tag">LOTES DE ALTO VALOR</div>
      <h2 class="hvd-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="hvd-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="hvd-grid">
      {%- assign target_collection = section.settings.collection -%}
      {%- if target_collection == blank or target_collection.products_count == 0 -%}
        {%- assign collection_obj = collections[section.settings.collection] | default: collections.all -%}
      {%- else -%}
        {%- assign collection_obj = target_collection -%}
      {%- endif -%}

      {%- assign products_rendered = 0 -%}

      {%- if collection_obj != blank and collection_obj.products.size > 0 -%}
        {%- for product in collection_obj.products -%}
          {%- assign passes_filter = false -%}
          {%- if section.settings.filter_min_price -%}
            {%- if product.price >= 6000 -%}
              {%- assign passes_filter = true -%}
            {%- endif -%}
          {%- else -%}
            {%- assign passes_filter = true -%}
          {%- endif -%}

          {%- if passes_filter and products_rendered < section.settings.products_to_show -%}
            {%- assign products_rendered = products_rendered | plus: 1 -%}
            {%- assign savings = 0 -%}
            {%- assign dollar_savings = 0 -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              {%- assign dollar_savings = product.compare_at_price | minus: product.price -%}
            {%- endif -%}



            <div class="hvd-card">
              <div class="hvd-card-media">
                {%- if savings > 0 -%}
                  <span class="hvd-discount-badge">-{{ savings }}%</span>
                {%- endif -%}
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                {%- else -%}
                  <img src="{{ 'card-generator.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                {%- endif -%}
              </div>
              <div class="hvd-card-body">
                <a href="{{ product.url }}" class="hvd-card-title">{{ product.title }}</a>
                <div class="hvd-price-row">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="hvd-compare-price">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                  <span class="hvd-sale-price">{{ product.price | money }}</span>
                </div>
                {%- if dollar_savings > 0 -%}
                  <span class="hvd-savings-pill">Ahorras {{ dollar_savings | money }}</span>
                {%- endif -%}

                {%- if product.available -%}
                  <form method="post" action="{{ routes.cart_add_url }}">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="hvd-btn">Añadir al Carrito</button>
                  </form>
                {%- else -%}
                  <button type="button" class="hvd-btn" disabled style="opacity:0.45;cursor:not-allowed;">Agotado</button>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Rellenar ranuras restantes si hay menos productos que los solicitados para mantener la grilla perfecta {%- endcomment -%}
      {%- assign remaining_slots = section.settings.products_to_show | minus: products_rendered -%}
      {%- if remaining_slots > 0 and section.settings.show_demo_placeholders -%}
        {%- assign demo_items = "Generador Inverter Portátil 2500W Silencioso,Kit Taladro Percutor Pro 20V Max + Baterías,Hidrolavadora Industrial Ultra-Pro 3000 PSI,Compresor Portátil de Alta Potencia 6 Gal" | split: "," -%}
        {%- assign demo_prices = "$189.00,$129.00,$219.00,$149.00" | split: "," -%}
        {%- assign demo_compare = "$329.00,$249.00,$449.00,$299.00" | split: "," -%}
        {%- assign demo_savings = "$140.00,$120.00,$230.00,$150.00" | split: "," -%}
        {%- assign demo_pcts = "-42%,-48%,-51%,-50%" | split: "," -%}
        {%- assign demo_imgs = "card-generator.jpg,card-dewalt.jpg,card-washer.jpg,card-generator.jpg" | split: "," -%}


        {%- assign start_idx = products_rendered -%}
        {%- assign end_idx = section.settings.products_to_show | minus: 1 -%}
        {%- for i in (start_idx..end_idx) -%}
          {%- assign mod_i = i | modulo: 4 -%}
          <div class="hvd-card">
            <div class="hvd-card-media">
              <span class="hvd-discount-badge">{{ demo_pcts[mod_i] }}</span>
              <img src="{{ demo_imgs[mod_i] | asset_url }}" alt="{{ demo_items[mod_i] }}" loading="lazy" width="600" height="600">
            </div>
            <div class="hvd-card-body">
              <span class="hvd-card-title">{{ demo_items[mod_i] }}</span>
              <div class="hvd-price-row">
                <span class="hvd-compare-price">{{ demo_compare[mod_i] }}</span>
                <span class="hvd-sale-price">{{ demo_prices[mod_i] }}</span>
              </div>
              <span class="hvd-savings-pill">Ahorras {{ demo_savings[mod_i] }}</span>

              <button type="button" class="hvd-btn">Añadir al Carrito</button>
            </div>
          </div>
        {%- endfor -%}
      {%- elsif products_rendered == 0 and section.settings.show_demo_placeholders == false -%}
        <div class="hvd-empty">
          <p style="font-weight:700;font-size:1rem;color:#0f172a;margin:0 0 0.4rem;">Próximos Lotes de Alto Valor</p>
          <p style="font-size:0.85rem;margin:0;">Agrega productos ≥ $60 a la colección seleccionada.</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="hvd-footer">
        <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="hvd-view-all">
          Ver Catálogo Completo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lotes de Alto Valor",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título Principal", "default": "OFERTAS DE ALTO VALOR & LOTES EXCLUSIVOS" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Equipos de alto rendimiento con precio mayorista garantizado (≥ $60)." },
    { "type": "collection", "id": "collection", "label": "Colección de Alto Valor (≥ $60)" },
    { "type": "checkbox", "id": "filter_min_price", "label": "Filtrar solo productos ≥ $60", "default": false },
    { "type": "checkbox", "id": "show_demo_placeholders", "label": "Mostrar demos si la colección está vacía", "default": true },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 2, "label": "Cantidad de productos", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar 'Ver Catálogo Completo'", "default": true },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo de la Sección", "default": "#f8fafc" },
    { "type": "color", "id": "heading_color", "label": "Color del Título", "default": "#0f172a" },
    { "type": "color", "id": "subheading_color", "label": "Color del Subtítulo", "default": "#475569" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Espaciado Superior", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Espaciado Inferior", "default": 60 }
  ],
  "presets": [{ "name": "Lotes de Alto Valor" }]
}
{% endschema %}
