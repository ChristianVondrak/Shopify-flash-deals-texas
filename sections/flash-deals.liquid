    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Color del Texto del Badge",
      "default": "#e11d48"
    },
    {
      "type": "color",
      "id": "timer_bg",
      "label": "Fondo Contenedor Temporizador",
      "default": "#f9fafb"
    },
    {
      "type": "color",
      "id": "timer_box_bg",
