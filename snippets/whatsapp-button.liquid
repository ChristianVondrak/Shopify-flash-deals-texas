{% comment %}
  Floating WhatsApp Button for Flash Deals Texas
{% endcomment %}

{%- assign whatsapp_number = '12817065323' -%}
{%- assign whatsapp_message = 'Hola, tengo una consulta sobre las ofertas de Flash Deals Texas' | url_encode -%}

<a
  href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message }}"
  class="fdtx-whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
>
  <span class="fdtx-whatsapp-tooltip">¿Dudas con un lote? Escríbenos</span>
  <div class="fdtx-whatsapp-icon-wrap">
