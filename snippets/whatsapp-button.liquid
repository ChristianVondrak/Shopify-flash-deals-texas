    </svg>
  </div>
</a>

<style>
  .fdtx-whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fdtx-whatsapp-float:hover {
    transform: translateY(-4px) scale(1.04);
  }

  .fdtx-whatsapp-icon-wrap {
    width: 58px;
    height: 58px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    color: #ffffff;
    transition: box-shadow 0.25s ease;
  }

  .fdtx-whatsapp-float:hover .fdtx-whatsapp-icon-wrap {
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }

  .fdtx-whatsapp-icon {
    width: 32px;
    height: 32px;
  }

  .fdtx-whatsapp-tooltip {
    background: #0f172a;
    color: #ffffff;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.25);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fdtx-whatsapp-float:hover .fdtx-whatsapp-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media screen and (max-width: 600px) {
    .fdtx-whatsapp-float {
      bottom: 20px;
      right: 20px;
    }
    .fdtx-whatsapp-icon-wrap {
      width: 52px;
      height: 52px;
    }
    .fdtx-whatsapp-icon {
      width: 28px;
      height: 28px;
    }
    .fdtx-whatsapp-tooltip {
      display: none;
    }
  }
</style>
