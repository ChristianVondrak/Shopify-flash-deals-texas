    "liquidation_faq": {
      "type": "liquidation-faq",
      "blocks": {
        "faq-1": {
          "type": "faq_item",
          "settings": {
            "question": "¿Los artículos son 100% nuevos o reacondicionados?",
            "answer": "Todos nuestros artículos son 100% nuevos, sellados en su empaque original de fábrica. Provienen de sobrestock mayorista y cancelaciones de proyectos en Texas, nunca de devoluciones o equipos de segunda mano."
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "question": "¿Por qué los precios son tan bajos respecto al retail tradicional?",
            "answer": "Compramos por volumen lotes cerrados a distribuidores que necesitan rotar espacio en bodega rápidamente. Al vender online directamente desde nuestro almacén en Dallas sin cadenas de intermediarios, trasladamos el ahorro neto a nuestros clientes."
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cuánto tiempo tarda la entrega en Texas?",
            "answer": "Los pedidos se preparan y despachan en 24 horas hábiles desde Dallas, TX. El tiempo promedio de entrega en Texas es de 1 a 3 días hábiles vía paquetería express."
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "question": "¿Qué garantía tienen las herramientas y componentes eléctricos?",
            "answer": "Todos los productos cuentan con 30 días de garantía directa con nosotros contra cualquier defecto técnico o de fabricación, además de la cobertura oficial del fabricante correspondiente."
          }
        }
      },
