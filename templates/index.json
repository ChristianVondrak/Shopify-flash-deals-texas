    "liquidation_faq": {
      "type": "liquidation-faq",
      "blocks": {
        "faq-1": {
          "type": "faq_item",
          "settings": {
            "question": "¿Los artículos son 100% nuevos o reacondicionados?",
            "answer": "Todos nuestros artículos son 100% nuevos, sellados en su empaque original de fábrica. Provienen de sobrestock mayorista y cancelaciones de proyectos en Texas, nunca de devoluciones o equipos de segunda mano."
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "question": "¿Por qué los precios son tan bajos respecto al retail tradicional?",
            "answer": "Compramos por volumen lotes cerrados a distribuidores que necesitan rotar espacio en bodega rápidamente. Al vender online directamente desde nuestro almacén en Houston sin cadenas de intermediarios, trasladamos el ahorro neto a nuestros clientes."
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cuánto tiempo tarda la entrega en Texas?",
            "answer": "Los pedidos se preparan y despachan en 24 horas hábiles desde Houston, TX. El tiempo estimado de entrega es de aproximadamente 7 días hábiles vía paquetería."
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "question": "¿Qué garantía tienen los productos adquiridos?",
            "answer": "Todos los productos cuentan con una garantía de 5 días hábiles a partir de haber reportado el caso y reenviado el artículo a nuestra bodega en Houston."
          }
        },
        "faq-5": {
          "type": "faq_item",
          "settings": {
            "question": "¿Qué pasa si mi producto llega dañado?",
            "answer": "Si el producto llega dañado durante el envío, contáctanos inmediatamente y envíanos fotografías del producto, el empaque y la etiqueta de envío. Evaluaremos el caso y te indicaremos los siguientes pasos."
          }
        },
        "faq-6": {
          "type": "faq_item",
          "settings": {
            "question": "¿Los productos pueden agotarse rápidamente?",
            "answer": "Sí. La mercancía de liquidación suele estar disponible en cantidades limitadas. Algunos productos pueden no volver a estar disponibles una vez agotados."
          }
        },
        "faq-7": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo puedo contactar a Flash Deals Texas?",
            "answer": "Puedes comunicarte con nosotros a través de nuestros canales de contacto disponibles en la página web. Estamos aquí para ayudarte con preguntas sobre productos, pedidos, envíos y compras."
          }
        }
